// VFM edge firmware: the ESP32 samples fast, estimates flow ON THE DEVICE, and sends a summary.
//
// Edge-computing idea: do the work next to the sensor.
//   - A 10 Hz fast loop samples the pump power (INA219).
//   - Every 1 s window it averages those 10 samples and runs the flow estimator locally
//     (vfm_estimator.h, the same code that is checked against the Python estimator).
//   - It then prints ONE summary line per second instead of ten raw samples, and the estimate
//     keeps working if the laptop, USB or (later) Wi-Fi goes away.
//
// The model in profile.h is generated by tools/export_edge_profile.py. Regenerate and re-flash
// it whenever a new profile is fitted. The estimate refuses (reason code) outside the
// calibrated ranges; it never invents a number.
//
// Libraries (Library Manager): Adafruit INA219, OneWire, DallasTemperature,
// "HX711 Arduino Library" by Bogdan Necula.
// Pins: INA219 SDA=21 SCL=22, DS18B20 DATA=4 (4.7k pull-up to 3V3), HX711 DT=25 SCK=26.

#include <Wire.h>
#include <Adafruit_INA219.h>
#include <OneWire.h>
#include <DallasTemperature.h>
#include "HX711.h"
#include "vfm_estimator.h"
#include "profile.h"

const int PIN_SDA = 21, PIN_SCL = 22;
const int PIN_DS18B20 = 4;
const int PIN_HX_DT = 25, PIN_HX_SCK = 26;

const unsigned long FAST_PERIOD_MS = 100;   // 10 Hz fast loop
const int WINDOW_N = 10;                    // samples per summary: one summary per second

// 0 = load cell not calibrated yet: only raw counts are sent.
const float HX_COUNTS_PER_GRAM = 0.0;
const long HX_OFFSET = 0;

Adafruit_INA219 ina;
OneWire oneWire(PIN_DS18B20);
DallasTemperature ds18b20(&oneWire);
HX711 scale;
bool inaOk = false;

unsigned long nextTick = 0;
int n = 0;
double sumVolts = 0, sumAmps = 0, sumPower = 0;
unsigned long loopMaxUs = 0;
bool haveHx = false;
long lastRaw = 0;

void setup() {
  Serial.begin(115200);
  Wire.begin(PIN_SDA, PIN_SCL);
  inaOk = ina.begin();
  ds18b20.begin();
  ds18b20.setWaitForConversion(false);
  ds18b20.requestTemperatures();
  scale.begin(PIN_HX_DT, PIN_HX_SCK);
  nextTick = millis();
}

void publishWindow() {
  String line = "{";
  bool first = true;
  float meanVolts = NAN, meanPower = NAN;

  if (inaOk && n > 0) {
    meanVolts = sumVolts / n;
    const float meanAmps = sumAmps / n;
    meanPower = sumPower / n;
    line += "\"ina219\":{\"volts\":" + String(meanVolts, 3) + ",\"amps\":" + String(meanAmps, 4) + "}";
    first = false;
  }

  float tempC = ds18b20.getTempCByIndex(0);
  ds18b20.requestTemperatures();
  const bool tempOk = tempC != DEVICE_DISCONNECTED_C && tempC > -55.0 && tempC < 125.0;
  if (tempOk) {
    line += String(first ? "" : ",") + "\"ds18b20\":{\"temp_c\":" + String(tempC, 2) + "}";
    first = false;
  }

  if (haveHx) {
    line += String(first ? "" : ",") + "\"hx711\":{\"raw\":" + String(lastRaw);
    if (HX_COUNTS_PER_GRAM != 0.0) {
      line += ",\"mass_g\":" + String((lastRaw - HX_OFFSET) / HX_COUNTS_PER_GRAM, 1);
    }
    line += "}";
    first = false;
  }

  // The edge estimate: computed here, on the ESP32, from the window average.
  const unsigned long t0 = micros();
  const EdgeResult r = edgeEstimate(EDGE_PROFILE, meanPower, meanVolts, tempOk ? tempC : NAN);
  const unsigned long computeUs = micros() - t0;
  line += String(first ? "" : ",") + "\"edge\":{\"available\":" + String(r.available ? 1 : 0);
  if (r.available) line += ",\"flow_l_min\":" + String(r.flow, 3);
  line += ",\"reason\":" + String(r.reason) + ",\"window_n\":" + String(n) +
          ",\"compute_us\":" + String(computeUs) + ",\"loop_max_us\":" + String(loopMaxUs) + "}";

  line += "}";
  Serial.println(line);

  n = 0;
  sumVolts = sumAmps = sumPower = 0;
  loopMaxUs = 0;
}

void loop() {
  const unsigned long now = millis();
  if ((long)(now - nextTick) < 0) return;      // not time for the next fast tick yet
  nextTick += FAST_PERIOD_MS;
  const unsigned long started = micros();

  if (inaOk) {
    const float volts = ina.getBusVoltage_V();
    const float amps = ina.getCurrent_mA() / 1000.0;
    if (isfinite(volts) && isfinite(amps)) {
      sumVolts += volts;
      sumAmps += amps;
      sumPower += volts * amps;
      n++;
    }
  }
  if (scale.is_ready()) {
    lastRaw = scale.read();
    haveHx = true;
  }

  const unsigned long used = micros() - started;
  if (used > loopMaxUs) loopMaxUs = used;

  if (n >= WINDOW_N) publishWindow();
}
